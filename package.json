{
  "name": "@mohamed_abd_elnaby/react-native-liquid",
  "version": "1.2.0",
  "description": "Liquid glass UI components for React Native and React Navigation: bottom tabs, top tabs, headers, toggles and more",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "mohamedabdelnaby-react-native-liquid-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "USAGE.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE-AndroidLiquidGlass",
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "clean": "del-cli lib",
    "prepare": "bob build",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "jest",
    "release": "release-it --only-version"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "liquid-glass",
    "glass",
    "glassmorphism",
    "react-navigation",
    "tab-bar",
    "bottom-tabs",
    "top-tabs",
    "header",
    "ios-26",
    "jetpack-compose"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohamedAbdElNaby/liquid.git"
  },
  "author": "Mohamed AbdElNaby <kamohamedabdelnabyly@gmail.com> (https://github.com/MohamedAbdElNaby)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MohamedAbdElNaby/liquid/issues"
  },
  "homepage": "https://github.com/MohamedAbdElNaby/liquid#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@jest/globals": "^29.7.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/material-top-tabs": "^7.8.1",
    "@react-navigation/native": "^7.5.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/react": "^19.2.0",
    "commitlint": "^21.2.4",
    "del-cli": "^8.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^29.7.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-builder-bob": "^0.43.2",
    "react-native-pager-view": "9.0.7",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "release-it": "^21.1.1",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@react-navigation/bottom-tabs": ">=7.0.0",
    "@react-navigation/material-top-tabs": ">=7.0.0",
    "react": "*",
    "react-native": "*",
    "react-native-safe-area-context": ">=4.0.0"
  },
  "packageManager": "yarn@4.18.1",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "ReactNativeLiquidViewSpec",
    "type": "all",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.mohamedabdelnaby.reactnativeliquid"
    },
    "ios": {
      "components": {
        "RNLiquidGlassView": {
          "className": "RNLiquidGlassView"
        },
        "RNLiquidGlassContainerView": {
          "className": "RNLiquidGlassContainerView"
        },
        "RNLiquidSwitch": {
          "className": "RNLiquidSwitch"
        },
        "RNLiquidSlider": {
          "className": "RNLiquidSlider"
        },
        "RNLiquidTabBar": {
          "className": "RNLiquidTabBar"
        },
        "RNLiquidMenu": {
          "className": "RNLiquidMenu"
        },
        "RNLiquidSearch": {
          "className": "RNLiquidSearch"
        }
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "testEnvironmentOptions": {
      "customExportConditions": [
        "require",
        "react-native",
        "mohamedabdelnaby-react-native-liquid-source"
      ]
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/example/",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependenciesMeta": {
    "lefthook": {
      "built": true
    }
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "create-react-native-library": {
    "type": "fabric-view",
    "languages": "kotlin-objc",
    "tools": [
      "eslint",
      "jest",
      "lefthook",
      "release-it"
    ],
    "version": "0.64.0"
  },
  "peerDependenciesMeta": {
    "@react-navigation/bottom-tabs": {
      "optional": true
    },
    "@react-navigation/material-top-tabs": {
      "optional": true
    }
  }
}
